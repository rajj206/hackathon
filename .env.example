# Local-first defaults: no cloud credentials or network calls.
# Subscription selection is intentionally not an application setting.
DATA_DIR=./data
MAX_UPLOAD_MB=25
EXTRACTOR_PROVIDER=heuristic
CHAT_PROVIDER=local
WAR_ROOM_PROVIDER=disabled
TRANSCRIPTION_PROVIDER=local
SEED_ROLE_SIMULATIONS=false
ROLE_SIMULATIONS_CORPUS_DIR=./demo-data/role-simulations/northstar-mixed

# Azure OpenAI (optional). DefaultAzureCredential is used when API key is omitted.
# Managed identity is preferred in Azure; locally use `az login`.
# Configure these only during a later Azure integration/deployment step.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR-CHAT-DEPLOYMENT
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_API_KEY=

# Azure AI Speech file transcription (optional).
# This adapter requires a Speech resource key; it does not claim passwordless support.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=en-US
